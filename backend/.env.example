# Copy to backend/.env and fill in your keys.
# Never commit real API keys.

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# local = CSV + trained model (default, works offline)
# live  = scrape FFD bulletin, fall back to local on failure
FLOODSHIELD_MODE=local

# Seconds to cache /api/status in memory
FLOODSHIELD_STATUS_TTL=120

# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=https://your-frontend.example.com
